{% raw %}name: bosun

# Written by the bosun splice channel (owned: `splice update --channel bosun` replaces it, so a
# local edit is drift). Every gate runs `bosun gate <name>`; change a gate's command in
# .bosun/profiles/<profile>.toml. The repo's own ci.yml, if any, is never touched.
#
# CI minutes (docs/ci-minutes.md in keelstackhq/bosun): a private repo pays for every job, each
# rounded up to a whole minute, so everything runs in ONE job that carries the required check's
# name. A draft fails it at once (ready_for_review runs the gates), and after a PR body or title
# edit only test-integrity (which reads the body) runs again on a head that passed. Run the same gates locally first:
# AGENTS.md has the one command.
on:
  pull_request:
    branches: [main]
    # `edited` covers a stacked PR being retargeted to main and a new `snapshot-change:` line.
    types: [opened, synchronize, reopened, edited, ready_for_review]
  push:
    branches: [main]
  merge_group:
  # main-health runs the same gates weekly on all of main.
  workflow_call:

# One group per PR. A push (or a retarget) cancels the older run of the PR. A body or title edit
# never cancels: it waits for the running run, then keeps that run's file gates when it passed
# and runs test-integrity on its own body (else every gate). So an edit never leaves a cancelled
# run and a red aggregate check behind.
concurrency:
  group: bosun-${{ github.event.pull_request.number || github.ref }}-${{ github.event_name }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' && !(github.event.action == 'edited' && !github.event.changes.base) }}

# checks: read lets a body edit read the head's earlier result.
permissions:
  contents: read
  checks: read

# A PR's .cargo/config.toml must not swap the compiler cargo runs (a rustc wrapper or
# build.rustc would run PR code in rust-cache and the gates before lint): cargo takes these over
# its config files. The rust toolchain step refuses a toolchain file that names a path.
env:
  # pnpm loads a .pnpmfile.cjs (or the pnpmfile pnpm-workspace.yaml names) for every command:
  # setup-node's `pnpm store path`, install, audit (deps), rebuild. Never in this job.
  npm_config_ignore_pnpmfile: "true"
  RUSTC: rustc
  RUSTC_WRAPPER: ""
  RUSTC_WORKSPACE_WRAPPER: ""
  CARGO_BUILD_RUSTC_WRAPPER: ""
  CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER: ""

jobs:
  # The required CI check (spec D15). It fails unless the pin check and every gate succeeded.
  # Beside a repo's own ci.yml and its ci-ok, it is called bosun-ok. A draft PR fails it in a few
  # seconds (never skipped: a skipped required check counts as passed); marking it ready runs it.
{% endraw %}{% if own_ci %}  bosun-ok:
{% else %}  ci-ok:
{% endif %}{% raw %}    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      # Docs-only fast path (pull requests only): when every changed file is a *.md under docs/ or
      # plans/ or at the root (not README.md), no gate runs and the check passes. Not for the
      # ts-pnpm stack: its fmt gate (prettier) checks Markdown too, so docs_only is always false.
      # Any other event, an empty diff or a diff that cannot be computed gives docs_only=false
      # (fail closed). risk.yml and verdict.yml are separate workflows and still judge such a PR.
{% endraw %}{% if "ts-pnpm" in pieces %}{% raw %}      - id: diff
        run: echo "docs_only=false" >> "$GITHUB_OUTPUT"
{% endraw %}{% else %}{% raw %}      - if: github.event_name == 'pull_request'
        id: diff
        env:
          BASE: ${{ github.event.pull_request.base.sha }}
          HEAD: ${{ github.event.pull_request.head.sha }}
        run: |
          docs_only=false
          # --no-renames lists both sides of a move, so a file moved out of src/ counts.
          if files="$(git diff --name-only --no-renames "$BASE...$HEAD")" && [ -n "$files" ]; then
            docs_only=true
            while IFS= read -r f; do
              # README.md may hold doctests (`include_str!`), so it runs the gates.
              case "$f" in
                README.md) docs_only=false ;;
                docs/*.md|plans/*.md) ;;
                */*) docs_only=false ;;
                *.md) ;;
                *) docs_only=false ;;
              esac
            done <<EOF
          $files
          EOF
          fi
          echo "docs_only=$docs_only" >> "$GITHUB_OUTPUT"
{% endraw %}{% endif %}{% raw %}
      # A body or title edit that did not retarget the PR changes no file, so the gates that read
      # only files keep the result of the head's newest finished run of this check (GitHub
      # Actions, not this run). test-integrity also reads the PR body, and that run may have read
      # another body (an edit can replace a pending run), so after a success it runs again on the
      # body of this event (mode=integrity). After anything else, or none, every gate runs.
      - if: github.event.action == 'edited' && !github.event.changes.base
        id: edit
        env:
          GH_TOKEN: ${{ github.token }}
          HEAD: ${{ github.event.pull_request.head.sha }}
          CHECK: ${{ github.job }}
        run: |
          mode=run
          prev="$(gh api "repos/$GITHUB_REPOSITORY/commits/$HEAD/check-runs?check_name=$CHECK&filter=all&per_page=100" \
            --jq "[.check_runs[] | select(.app.slug == \"github-actions\" and .status == \"completed\" and (.details_url | contains(\"/runs/$GITHUB_RUN_ID/\") | not))] | max_by(.id) | .conclusion // \"\"" || true)"
          if [ "$prev" = success ]; then mode=integrity; fi
          echo "the head's earlier $CHECK: ${prev:-none}; mode=$mode"
          echo "mode=$mode" >> "$GITHUB_OUTPUT"
      # work: run the pinned bosun and gates; setup: install the stack's tools; only: the gates.
      - id: plan
        env:
          DRAFT: ${{ github.event.pull_request.draft || false }}
          DOCS_ONLY: ${{ steps.diff.outputs.docs_only }}
          MODE: ${{ steps.edit.outputs.mode || 'run' }}
        run: |
          if [ "$DRAFT" = true ]; then echo "::error::draft: not checked; mark it ready to run the gates"; exit 1; fi
          if [ "$DOCS_ONLY" = true ]; then
            echo "work=false" >> "$GITHUB_OUTPUT"; echo "docs only: no gate runs"
          elif [ "$MODE" = integrity ]; then
            { echo "work=true"; echo "setup=false"; echo "only=test-integrity"; } >> "$GITHUB_OUTPUT"
            echo "this head passed the file gates; test-integrity runs on this body"
          else
            { echo "work=true"; echo "setup=true"; } >> "$GITHUB_OUTPUT"
          fi
      # The gates run the bosun release pinned in the base commit's .bosun/version, so a change to
      # the pin takes effect only after it merges. (A change to this file runs at once: R-ci.)
      - if: steps.plan.outputs.work == 'true'
        name: pinned release of the base
        id: pin
        env:
          BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}
          EVENT: ${{ github.event_name }}
        run: |
          v=""
          if [ -n "$BASE" ]; then v="$(git show "$BASE:.bosun/version" 2>/dev/null | tr -d '[:space:]' || true)"; fi
          if [ -z "$v" ]; then
            # No base (weekly run), or a base with no bosun yet (the setup PR): this commit's pin.
            v="$(tr -d '[:space:]' < .bosun/version)"
            if [ "$EVENT" = pull_request ]; then
              echo "::warning::the base pins no bosun release yet; using this change's pin $v (setup PR)"
            fi
          fi
          # An exact x.y.z only: never a dist-tag, range, URL or path.
          printf '%s' "$v" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || {
            echo "::error::.bosun/version must be an exact x.y.z, not '$v'"
            exit 1
          }
          echo "version=$v" >> "$GITHUB_OUTPUT"
      - if: steps.plan.outputs.work == 'true'
        name: install the pinned release
        id: bin
        env:
          VERSION: ${{ steps.pin.outputs.version }}
        run: |
          npm install -g --ignore-scripts "@keelstackhq/bosun@${VERSION}"
          dir="$(cd "$(npm root -g)/@keelstackhq/bosun" && node -p "require('path').dirname(require.resolve('@keelstackhq/bosun-linux-x64/package.json'))")"
          mkdir -p "$RUNNER_TEMP/bin"
          cp "$dir/bin/bosun" "$RUNNER_TEMP/bin/bosun"
          got="$("$RUNNER_TEMP/bin/bosun" --version)"
          echo "$got"
          test "$got" = "bosun ${VERSION}"
          # The gates check the binary against this hash before each gate.
          echo "sha256=$(sha256sum "$RUNNER_TEMP/bin/bosun" | cut -d' ' -f1)" >> "$GITHUB_OUTPUT"
      # The pin a change sets must be a published release that reports its own version.
      - if: steps.plan.outputs.work == 'true'
        name: the pinned release installs and reports its version
        env:
          BASE_VERSION: ${{ steps.pin.outputs.version }}
        run: |
          v="$(tr -d '[:space:]' < .bosun/version)"
          printf '%s' "$v" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || {
            echo "::error::.bosun/version must be an exact x.y.z, not '$v'"
            exit 1
          }
          if [ "$v" = "$BASE_VERSION" ]; then echo "same pin as the base: installed above"; exit 0; fi
          npm install -g --ignore-scripts "@keelstackhq/bosun@${v}"
          got="$(bosun --version)"
          echo "$got"
          test "$got" = "bosun ${v}"
      # Before anything runs rustc, cargo or the stack's tools (rust-cache included).
      - if: steps.plan.outputs.work == 'true'
        name: the base's config for the gates
        env:
          BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}
        run: |
          case "$BASE" in ""|0000000000000000000000000000000000000000) BASE="$GITHUB_SHA";; esac
          # The gates use the base commit's copies of the files that decide what runs: .bosun/ (the gate
          # commands are in its profiles), every .cargo directory (aliases, includes, rustc wrappers)
          # every rust-toolchain(.toml) (a path would run a compiler from the PR), every .npmrc
          # (node-options would load PR code into each pnpm call) and every .pnpmfile. Files the base
          # lacks are deleted, also when the PR made the path a symlink. A PR's changes to them take
          # effect after it merges; they are R-gov or R-ci, so the owner sees them.
          pat='(^|/)\.cargo(/|$)|(^|/)rust-toolchain(\.toml)?$|(^|/)\.npmrc$|(^|/)\.pnpmfile\.[cm]?js$|^\.bosun(/|$)'
          if ! git cat-file -e "$BASE:.bosun/version" 2>/dev/null; then
            echo "::warning::the base has no .bosun yet (setup PR): this change's .bosun is used"
            pat='(^|/)\.cargo(/|$)|(^|/)rust-toolchain(\.toml)?$|(^|/)\.npmrc$|(^|/)\.pnpmfile\.[cm]?js$'
          fi
          changed="$(git diff --name-only -z "$BASE" HEAD | { grep -zE "$pat" || true; } | tr '\0' ' ')"
          if [ -n "$changed" ]; then
            echo "::notice::this change edits ${changed}; its gates run with the base's copies (they apply after merge)"
          fi
          git ls-tree -r -z --name-only HEAD | { grep -zE "$pat" || true; } | while IFS= read -r -d '' p; do
            rm -rf -- "$p"
          done
          git ls-tree -r -z --name-only "$BASE" | { grep -zE "$pat" || true; } | while IFS= read -r -d '' p; do
            mkdir -p -- "$(dirname -- "$p")"
            git show "$BASE:$p" > "$p"
          done
{% endraw %}{% if "rust" in pieces %}      # rust stack: one toolchain install. With a rust-toolchain(.toml) in rust_path or a parent
      # up to the repo root, `rustup toolchain install` installs what it names. Without one, the
      # old pin (the RUST_VERSION fallback of docs/setup-script.sh; a test keeps them equal): a bare
      # `rustup toolchain install` would install the runner's default (stable).
      - if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true'
        name: rust toolchain
        working-directory: {{ rust_path }}
        run: |
          d="$PWD"; found=""
          while :; do
            if [ -f "$d/rust-toolchain.toml" ] || [ -f "$d/rust-toolchain" ]; then found=1; break; fi
            if [ "$d" = "$GITHUB_WORKSPACE" ] || [ "$d" = / ]; then break; fi
            d="$(dirname "$d")"
          done
          # The toolchain file is the base's here (step `the base's config for the gates`). A
          # TOML parser still checks it: only a [toolchain] with a plain channel, components,
          # targets and profile (a `path` would make rustup run another compiler), and later
          # steps get RUSTUP_TOOLCHAIN, so rustup reads no toolchain file after this step.
          ch=1.97
          if [ -n "$found" ]; then
            ch="$(python3 -I - "$d" <<'PY'
          import os, re, sys, tomllib
          name = re.compile(r"[0-9A-Za-z._-]+")
          def ok(s):
              return isinstance(s, str) and name.fullmatch(s) is not None
          def check(p):
              with open(p, "rb") as f:
                  raw = f.read()
              text = raw.decode("utf-8", "strict")
              if p.endswith("rust-toolchain") and ok(text.strip()) and "\n" not in text.strip():
                  return text.strip()
              t = tomllib.loads(text)
              tc = t.get("toolchain")
              if set(t) != {"toolchain"} or not isinstance(tc, dict):
                  sys.exit(f"{p}: only a [toolchain] table is allowed")
              extra = set(tc) - {"channel", "components", "targets", "profile"}
              if extra or not ok(tc.get("channel")):
                  sys.exit(f"{p}: name a released channel; only channel, components, targets and profile are allowed")
              for k in ("components", "targets"):
                  v = tc.get(k, [])
                  if not isinstance(v, list) or not all(ok(x) for x in v):
                      sys.exit(f"{p}: {k} must be a list of plain names")
              if "profile" in tc and not ok(tc["profile"]):
                  sys.exit(f"{p}: profile must be a plain name")
              return tc["channel"]
          d = sys.argv[1]
          chosen = None
          # rustup reads rust-toolchain over rust-toolchain.toml when both exist; both must pass.
          for fn in ("rust-toolchain.toml", "rust-toolchain"):
              p = os.path.join(d, fn)
              if os.path.lexists(p):
                  try:
                      chosen = check(p)
                  except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
                      sys.exit(f"{p}: not readable ({e})")
          print(chosen)
          PY
          )"
          fi
          echo "RUSTUP_TOOLCHAIN=$ch" >> "$GITHUB_ENV"
          if [ -n "$found" ]; then
            rustup toolchain install
          else
            rustup toolchain install 1.97 --profile minimal -c rustfmt,clippy
            rustup default 1.97
          fi
          rustup component add rustfmt clippy
      - if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true'
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: {{ rust_path }}
          # Not ~/.cargo/bin: a cache a PR's earlier run saved must not put a binary (git, rustfmt,
          # cargo-deny) on PATH before test-integrity, deps or fmt.
          cache-bin: "false"
      - if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true'
        uses: taiki-e/install-action@v2
        with:
          tool: cargo-nextest,cargo-deny
{% endif %}{% if "ts-pnpm" in pieces %}      # ts-pnpm stack: Node 24, pnpm from package.json `packageManager`, the Turborepo cache
      # through hoard. Skipped while the stack has no lockfile yet (a new repo).
      # pnpm-workspace.yaml settings win over env and flags, so a PR could name a pnpmfile or
      # config dependencies there (or in a package.json `pnpm` field) and run code in
      # setup-node's `pnpm store path` or the deps gate's audit. A parser reads every tracked
      # pnpm-workspace.yaml and package.json `pnpm` field; only settings that run no code may
      # pass (fail closed).
      - if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true' && hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        name: pnpm workspace runs no PR code
        run: |
          python3 -I - <<'PY'
          import json, re, subprocess, sys, yaml
          class Strict(yaml.SafeLoader):
              pass
          def mapping(loader, node, deep=False):
              seen = set()
              for k, _ in node.value:
                  key = loader.construct_object(k, deep=deep)
                  if key in seen:
                      raise yaml.constructor.ConstructorError(None, None, f"duplicate key {key!r}", k.start_mark)
                  seen.add(key)
              return yaml.SafeLoader.construct_mapping(loader, node, deep)
          Strict.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, mapping)
          ok = {
              "allowBuilds",
              "packages", "catalog", "catalogs", "onlyBuiltDependencies", "ignoredBuiltDependencies",
              "neverBuiltDependencies", "overrides", "packageExtensions", "peerDependencyRules",
              "allowedDeprecatedVersions", "supportedArchitectures", "auditConfig",
              "linkWorkspacePackages", "saveWorkspaceProtocol", "autoInstallPeers",
              "strictPeerDependencies", "dedupePeerDependents", "minimumReleaseAge",
              "minimumReleaseAgeExclude",
          }
          out = subprocess.run(["git", "ls-files", "-z"], capture_output=True, check=True).stdout
          # pnpm links each dependency at node_modules/<name>: a name with ".." or a "/" other
          # than the scope's would link outside node_modules, even outside the checkout (a
          # parent .cargo that cargo reads). Every name must be a plain npm package name.
          name_re = re.compile(r"(@[A-Za-z0-9~-][A-Za-z0-9._~-]*/)?[A-Za-z0-9~-][A-Za-z0-9._~-]*")
          def names(f, deps):
              if deps is None:
                  return
              if not isinstance(deps, dict):
                  sys.exit(f"{f}: a dependency list must be a mapping")
              for n in deps:
                  if not isinstance(n, str) or not name_re.fullmatch(n):
                      sys.exit(f"{f}: {n!r} is not an npm package name; pnpm would link it outside node_modules")
          kinds = ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies")
          def lock_name(key):
              # "/@s/n@1.0.0(peer@2)" -> "@s/n"; v6 keys start with "/".
              k = str(key).lstrip("/")
              at = k.find("@", 1)
              return k if at < 0 else k[:at]
          def check(f, d):
              if d is None:
                  return
              if not isinstance(d, dict):
                  sys.exit(f"{f}: must be a mapping")
              bad = sorted(str(k) for k in d if k not in ok)
              if bad:
                  sys.exit(f"{f}: {', '.join(bad)} may run code before the gates (a pnpmfile, config dependencies); bosun's CI allows only " + ", ".join(sorted(ok)))
          for f in out.decode().split("\0"):
              # A package.json `pnpm` field holds pnpm settings too.
              if f.rsplit("/", 1)[-1] == "package.json":
                  try:
                      with open(f, "rb") as h:
                          pkg = json.load(h)
                  except Exception as e:
                      sys.exit(f"{f}: not readable JSON ({e})")
                  if isinstance(pkg, dict):
                      for k in kinds:
                          names(f + " " + k, pkg.get(k))
                      if "pnpm" in pkg:
                          check(f + " (pnpm)", pkg["pnpm"])
                  continue
              if f.rsplit("/", 1)[-1] == "pnpm-lock.yaml":
                  # The frozen install links what the lockfile says, extensions included.
                  try:
                      with open(f, "rb") as h:
                          lock = yaml.load(h, Loader=Strict) or {}
                  except Exception as e:
                      sys.exit(f"{f}: not readable YAML ({e})")
                  if not isinstance(lock, dict):
                      sys.exit(f"{f}: must be a mapping")
                  for sec in ("importers", "packages", "snapshots"):
                      entries = lock.get(sec) or {}
                      if not isinstance(entries, dict):
                          sys.exit(f"{f}: {sec} must be a mapping")
                      for key, e in entries.items():
                          if sec != "importers":
                              names(f + " " + sec, {lock_name(key): 1})
                          if isinstance(e, dict):
                              for k in kinds:
                                  names(f + " " + sec + " " + str(key), e.get(k))
                  continue
              if f.rsplit("/", 1)[-1] not in ("pnpm-workspace.yaml", "pnpm-workspace.yml"):
                  continue
              try:
                  with open(f, "rb") as h:
                      d = yaml.load(h, Loader=Strict)
              except Exception as e:
                  sys.exit(f"{f}: not readable YAML ({e})")
              check(f, d)
          PY
      - uses: pnpm/action-setup@v4
        if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true' && hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        with:
          package_json_file: {{ ts_path }}/package.json
      - uses: actions/setup-node@v4
        if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true' && hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        with:
          node-version: 24
          cache: pnpm
          cache-dependency-path: {{ ts_path }}/pnpm-lock.yaml
      - if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true' && hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        working-directory: {{ ts_path }}
        # No PR code before the gates: no pnpmfile and no lifecycle scripts run here; `pnpm
        # rebuild` runs the install scripts (the root project's postinstall too) before fmt, the
        # first gate that runs PR code in this stack.
        # It must not change any file outside node_modules (a patch whose path leaves its
        # package could rewrite pnpm-workspace.yaml or add an .npmrc): a fingerprint of the
        # status, the diff to HEAD, untracked files and every .npmrc, .pnpmfile.* and
        # pnpm-workspace.yaml (ignored or not), all from the top level, must be the same before
        # and after. So must every .cargo and .npmrc from the checkout's parent up to $HOME,
        # which cargo and pnpm read too.
        run: |
          top="$(git rev-parse --show-toplevel)"
          above() {
            d="$(dirname "$top")"
            while :; do
              for n in .cargo .npmrc; do
                if [ -e "$d/$n" ] || [ -L "$d/$n" ]; then
                  echo "$d/$n"
                  find "$d/$n" -maxdepth 1 \( -name .npmrc -o -name 'config*' \) -type f -print0 | sort -z | xargs -0r sha256sum
                fi
              done
              if [ "$d" = "$HOME" ] || [ "$d" = / ]; then break; fi
              d="$(dirname "$d")"
            done
          }
          fp() {
            (
              cd "$top"
              git status --porcelain=v1 -z --untracked-files=all
              git diff --binary HEAD
              git ls-files -o --exclude-standard -z | xargs -0r sha256sum
              find . -name node_modules -prune -o \( -name .npmrc -o -name '.pnpmfile.*' -o -name 'pnpm-workspace.y*ml' \) -print0 \
                | sort -z | xargs -0r sha256sum
            ) | sha256sum
          }
          before="$(fp)"
          before_above="$(above)"
          pnpm install --frozen-lockfile --ignore-scripts --ignore-pnpmfile
          if [ "$(fp)" != "$before" ]; then
            git status --short --untracked-files=all
            echo "::error::pnpm install changed files in the checkout (see above); only node_modules may change, and it must be in .gitignore"
            exit 1
          fi
          after_above="$(above)"
          if [ "$after_above" != "$before_above" ]; then
            diff <(echo "$before_above") <(echo "$after_above") || true
            echo "::error::pnpm install changed a .cargo or .npmrc above the checkout (see above)"
            exit 1
          fi
          # Defence in depth: no link in node_modules leads outside the checkout.
          while IFS= read -r -d '' l; do
            t="$(realpath -m -- "$l")"
            case "$t" in "$top"/*) ;; *) echo "::error::$l links outside the checkout ($t)"; exit 1 ;; esac
          done < <(find "$top" -path '*/node_modules/*' -type l -print0)
      - uses: keelstackhq/hoard@v0
        if: steps.plan.outputs.work == 'true' && steps.plan.outputs.setup == 'true' && hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
{% endif %}{% raw %}      # The gates run in order and stop at the first failure. The gates that run no PR code come
      # first: lint (build.rs, proc macros) and test run PR code on this runner, and with the
      # runner's sudo it could hide an earlier failure, so it never runs after one.
      - if: steps.plan.outputs.work == 'true'
        name: bosun gates
        env:
{% endraw %}{% if own_ci %}{% raw %}          # The repo's own ci.yml already runs fmt, lint, test and deps; only test-integrity is
          # unique to bosun. So a pull request runs just that and relies on the repo's own ci-ok
          # for the rest; if that CI lacks one (cargo-deny, say), set the repo variable
          # BOSUN_ALL_GATES to '1' to run all five on pull requests too. Every other event (push
          # to main, merge queue, the weekly run main-health calls, where github.event_name is
          # the caller's, e.g. schedule) runs all five gates.
          GATES: ${{ (vars.BOSUN_ALL_GATES == '1' || github.event_name != 'pull_request') && 'test-integrity deps fmt lint test' || 'test-integrity' }}
{% endraw %}{% else %}{% raw %}          GATES: test-integrity deps fmt lint test
{% endraw %}{% endif %}{% raw %}          # An edit after a success runs test-integrity only (see the edit step).
          ONLY: ${{ steps.plan.outputs.only }}
          BOSUN_SHA256: ${{ steps.bin.outputs.sha256 }}
          # test-integrity reads the snapshot-change line from the PR body.
          BOSUN_PR_BODY: ${{ github.event.pull_request.body }}
          EVENT: ${{ github.event_name }}
        run: |
          bosun="$RUNNER_TEMP/bin/bosun"
          GATES="${ONLY:-$GATES}"
          # A PR runs each gate on what it changed; main and the queue run it on everything.
          if [ "$EVENT" = "pull_request" ]; then all=""; else all="--all"; fi
          for g in $GATES; do
{% endraw %}{% if "ts-pnpm" in pieces %}            # In a ts-pnpm stack fmt is the first gate that runs PR code (a package.json script):
            # run the install scripts now (the root's postinstall too), after test-integrity and deps.
            if [ "$g" = fmt ] && [ -f "{{ ts_path }}/pnpm-lock.yaml" ]; then (cd "{{ ts_path }}" && pnpm rebuild); fi
{% endif %}{% raw %}            echo "::group::bosun gate $g"
            # Defence in depth: the pinned bosun, unchanged since step bin.
            echo "$BOSUN_SHA256  $bosun" | sha256sum -c --quiet || { echo "::error::$bosun changed"; exit 1; }
            "$bosun" gate "$g" $all || { echo "::error::gate $g failed; later gates did not run"; exit 1; }
            echo "::endgroup::"
          done
{% endraw %}