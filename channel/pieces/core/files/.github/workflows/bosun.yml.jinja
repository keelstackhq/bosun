{% raw %}name: bosun

# Written by the bosun splice channel (owned: `splice update --channel bosun` replaces it, so a
# local edit is drift). Every gate runs `bosun gate <name>`; change a gate's command in
# .bosun/profiles/<profile>.toml. The repo's own ci.yml, if any, is never touched.
on:
  pull_request:
    branches: [main]
    # `edited` covers a stacked PR being retargeted to main.
    types: [opened, synchronize, reopened, edited]
  push:
    branches: [main]
  merge_group:
  # main-health runs the same gates nightly on all of main.
  workflow_call:

# A new push to the same PR or branch cancels its older run. A body edit that did not retarget
# the PR gets a group of its own (`-edit-<run_id>`): it neither cancels the run of the latest
# push nor is cancelled by it, so editing a PR body never leaves a cancelled run and a red
# aggregate check behind. It is not skipped either: it runs every job, so its aggregate result on
# the head is as true as any other run's (a skipped, green aggregate posted after a red one on
# the same head would let a body edit turn a failed head green). A retarget (`changes.base`) keeps
# the shared group: the new run supersedes the old.
concurrency:
  group: bosun-${{ github.event.pull_request.number || github.ref }}-${{ github.event_name }}${{ github.event.action == 'edited' && !github.event.changes.base && format('-edit-{0}', github.run_id) || '' }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  # Docs-only fast path (pull requests only): when every changed file is under docs/ or plans/ or
  # is a root-level *.md, bosun-bin, gate and pin are skipped and the aggregate accepts that.
  # Any other event, an empty diff or a diff that cannot be computed gives docs_only=false
  # (fail closed). risk.yml and verdict.yml are separate workflows and still judge such a PR.
  changes:
    runs-on: ubuntu-latest
    outputs:
      docs_only: ${{ steps.diff.outputs.docs_only || 'false' }}
    steps:
      - if: github.event_name == 'pull_request'
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - if: github.event_name == 'pull_request'
        id: diff
        env:
          BASE: ${{ github.event.pull_request.base.sha }}
          HEAD: ${{ github.event.pull_request.head.sha }}
        run: |
          docs_only=false
          # --no-renames lists both sides of a move, so a file moved out of src/ counts.
          if files="$(git diff --name-only --no-renames "$BASE...$HEAD")" && [ -n "$files" ]; then
            docs_only=true
            while IFS= read -r f; do
              case "$f" in
                docs/*|plans/*) ;;
                */*) docs_only=false ;;
                *.md) ;;
                *) docs_only=false ;;
              esac
            done <<EOF
          $files
          EOF
          fi
          echo "docs_only=$docs_only" >> "$GITHUB_OUTPUT"

  # The gates run the bosun release pinned in the base commit's .bosun/version, so a change to
  # the pin takes effect only after it merges. (A change to this file runs at once: R-ci.)
  bosun-bin:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: pinned release of the base
        id: pin
        env:
          BASE: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before }}
          EVENT: ${{ github.event_name }}
        run: |
          v=""
          if [ -n "$BASE" ]; then v="$(git show "$BASE:.bosun/version" 2>/dev/null | tr -d '[:space:]' || true)"; fi
          if [ -z "$v" ]; then
            # No base (nightly), or a base with no bosun yet (the setup PR): use this commit's pin.
            v="$(tr -d '[:space:]' < .bosun/version)"
            if [ "$EVENT" = pull_request ]; then
              echo "::warning::the base pins no bosun release yet; using this change's pin $v (setup PR)"
            fi
          fi
          # An exact x.y.z only: never a dist-tag, range, URL or path.
          printf '%s' "$v" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || {
            echo "::error::.bosun/version must be an exact x.y.z, not '$v'"
            exit 1
          }
          echo "version=$v" >> "$GITHUB_OUTPUT"
      - name: install the pinned release
        env:
          VERSION: ${{ steps.pin.outputs.version }}
        run: |
          npm install -g --ignore-scripts "@keelstackhq/bosun@${VERSION}"
          dir="$(cd "$(npm root -g)/@keelstackhq/bosun" && node -p "require('path').dirname(require.resolve('@keelstackhq/bosun-linux-x64/package.json'))")"
          mkdir -p "$RUNNER_TEMP/bin"
          cp "$dir/bin/bosun" "$RUNNER_TEMP/bin/bosun"
          got="$("$RUNNER_TEMP/bin/bosun" --version)"
          echo "$got"
          test "$got" = "bosun ${VERSION}"
      - uses: actions/upload-artifact@v4
        with:
          name: bosun-bin
          path: ${{ runner.temp }}/bin/bosun
          retention-days: 1

  gate:
    name: gate-${{ matrix.gate }}
    needs: [changes, bosun-bin]
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 8
    strategy:
      fail-fast: false
      matrix:
{% endraw %}{% if own_ci %}{% raw %}        # The repo's own ci.yml already runs fmt, lint, test and deps; only test-integrity is unique
        # to bosun. So a pull request runs just that, unless the repo variable BOSUN_ALL_GATES is
        # '1'. Every other event (push to main, merge queue, the nightly run main-health calls,
        # where github.event_name is the caller's, e.g. schedule) runs all five gates.
        gate: ${{ fromJSON((vars.BOSUN_ALL_GATES == '1' || github.event_name != 'pull_request') && '["fmt","lint","test","deps","test-integrity"]' || '["test-integrity"]') }}
{% endraw %}{% else %}{% raw %}        gate: [fmt, lint, test, deps, test-integrity]
{% endraw %}{% endif %}{% raw %}    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          persist-credentials: false
{% endraw %}{% if "rust" in pieces %}      # rust stack: one toolchain install, the one rust-toolchain.toml names (`rustup toolchain
      # install` with no argument reads it from the working directory).
      - name: rust toolchain
        working-directory: {{ rust_path }}
        run: |
          if [ -f rust-toolchain.toml ] || [ -f rust-toolchain ]; then
            rustup toolchain install
            rustup component add rustfmt clippy
          else
            rustup toolchain install stable --profile minimal -c rustfmt,clippy
            rustup default stable
          fi
      - uses: Swatinem/rust-cache@v2
        with:
          workspaces: {{ rust_path }}
      - uses: taiki-e/install-action@v2
        with:
          tool: cargo-nextest,cargo-deny
{% endif %}{% if "ts-pnpm" in pieces %}      # ts-pnpm stack: Node 24, pnpm from package.json `packageManager`, the Turborepo cache
      # through hoard. Skipped while the stack has no lockfile yet (a new repo).
      - uses: pnpm/action-setup@v4
        if: hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        with:
          package_json_file: {{ ts_path }}/package.json
      - uses: actions/setup-node@v4
        if: hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        with:
          node-version: 24
          cache: pnpm
          cache-dependency-path: {{ ts_path }}/pnpm-lock.yaml
      - if: hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
        working-directory: {{ ts_path }}
        run: pnpm install --frozen-lockfile
      - uses: keelstackhq/hoard@v0
        if: hashFiles('{{ ts_path }}/pnpm-lock.yaml') != ''
{% endif %}{% raw %}      - uses: actions/download-artifact@v4
        with:
          name: bosun-bin
          path: ${{ runner.temp }}/bosun
      - name: bosun gate ${{ matrix.gate }}
        env:
          GATE: ${{ matrix.gate }}
          # test-integrity reads the snapshot-change line from the PR body.
          BOSUN_PR_BODY: ${{ github.event.pull_request.body }}
          EVENT: ${{ github.event_name }}
        run: |
          bosun="$RUNNER_TEMP/bosun/bosun"
          chmod +x "$bosun"
          # A PR runs the gate on what it changed; main and the queue run it on everything.
          if [ "$EVENT" = "pull_request" ]; then all=""; else all="--all"; fi
          "$bosun" gate "$GATE" $all

  # The pin a change sets must be a published release that reports its own version.
  pin:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - name: the pinned release installs and reports its version
        run: |
          v="$(tr -d '[:space:]' < .bosun/version)"
          printf '%s' "$v" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' || {
            echo "::error::.bosun/version must be an exact x.y.z, not '$v'"
            exit 1
          }
          npm install -g --ignore-scripts "@keelstackhq/bosun@${v}"
          got="$(bosun --version)"
          echo "$got"
          test "$got" = "bosun ${v}"

  # The required CI check (spec D15): it fails unless every job above succeeded, also when one
  # was skipped or cancelled. Beside a repo's own ci.yml and its ci-ok, it is called bosun-ok.
{% endraw %}{% if own_ci %}  bosun-ok:
{% else %}  ci-ok:
{% endif %}{% raw %}    needs: [changes, bosun-bin, gate, pin]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: All CI jobs succeeded
        env:
          CHANGES: ${{ needs.changes.result }}
          DOCS_ONLY: ${{ needs.changes.outputs.docs_only }}
          BIN: ${{ needs.bosun-bin.result }}
          GATE: ${{ needs.gate.result }}
          PIN: ${{ needs.pin.result }}
        run: |
          echo "changes: $CHANGES (docs_only=$DOCS_ONLY), bosun-bin: $BIN, gate: $GATE, pin: $PIN"
          # `changes` must have succeeded: a failed or cancelled one never lets the rest skip.
          test "$CHANGES" = success
          # The other jobs may be skipped only on the docs-only fast path.
          for r in "$BIN" "$GATE" "$PIN"; do
            if [ "$r" != success ] && ! { [ "$DOCS_ONLY" = true ] && [ "$r" = skipped ]; }; then
              exit 1
            fi
          done
{% endraw %}