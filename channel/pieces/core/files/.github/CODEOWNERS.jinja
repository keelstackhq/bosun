# Governance and CI need an owner review (spec §8, R-gov and R-ci). Code outside these paths
# merges through auto-merge after the gates (spec D13).
{% if owner %}/.bosun/              @{{ owner }}
/governance/          @{{ owner }}
/.github/             @{{ owner }}
/.claude/             @{{ owner }}
/.splice/             @{{ owner }}
/hoist.toml           @{{ owner }}
/AGENTS.md            @{{ owner }}
/REVIEW.md            @{{ owner }}
/CLAUDE.md            @{{ owner }}
{% if "rust" in pieces %}/deny.toml            @{{ owner }}
/rust-toolchain.toml  @{{ owner }}
{% endif %}{% if "ts-pnpm" in pieces %}/.npmrc               @{{ owner }}
{% endif %}{% else %}# Add `/.bosun/ @<login>` and the same for /governance/, /.github/, /.claude/, /.splice/,
# /hoist.toml, /AGENTS.md, /REVIEW.md, /CLAUDE.md and the R-ci files in .bosun/risk.toml.
{% endif %}