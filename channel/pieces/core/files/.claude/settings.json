{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bosun hook session-start" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__github__.*",
        "hooks": [{ "type": "command", "command": "bosun hook pre-tool-use" }]
      }
    ]
  }
}
